{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo Dev Server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/expo/bin/cli", "start"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/expo/bin/cli", "start", "--web"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo Android",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/expo/bin/cli", "start", "--android"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo iOS",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/expo/bin/cli", "start", "--ios"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
